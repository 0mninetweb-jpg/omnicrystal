WORLDSIM_API_KEY="change-me"
PORT=8081

# Optional: point this adapter at the original MiroFish runtime on a VM.
MIROFISH_BACKEND_URL=""
MIROFISH_BACKEND_API_KEY=""
MIROFISH_BEARER_TOKEN=""
MIROFISH_HTTP_TIMEOUT_SEC=180
MIROFISH_POLL_INTERVAL_SEC=5
MIROFISH_STAGE_TIMEOUT_SEC=3600
MIROFISH_JOB_DATA_DIR=".runtime/jobs"
MIROFISH_ALLOW_FALLBACK=true
