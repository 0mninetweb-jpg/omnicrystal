# Optional runtime env for Crystal WorldSim.
# Copy to functions/.env.omnicrystal when the project is on Blaze and ready for deploy.

# Legacy / synchronous sidecar path used by functions/worldSim.js.
WORLDSIM_BASE_URL=""
WORLDSIM_API_KEY=""

# Async adapter path used by functions/worldSimJobs.js.
MIROFISH_BASE_URL=""
MIROFISH_API_KEY=""

# Forecast runtime defaults.
LLM_PROVIDER="openrouter"
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_API_KEY=""
LLM_MODEL_QUERY="openai/gpt-4.1-mini"
LLM_MODEL_FORECAST="openai/gpt-4.1-mini"
LLM_MODEL_CHAT="openai/gpt-4.1-mini"
LLM_MODEL_COPY="openai/gpt-4.1-mini"
OPENROUTER_SITE_URL="https://omnicrystal.web.app"
OPENROUTER_APP_TITLE="Crystal"

# Optional sports grounding.
SPORTS_PROVIDER="api-football"
SPORTS_PROVIDER_BASE_URL="https://v3.football.api-sports.io"
API_FOOTBALL_KEY=""
FRED_API_KEY=""

# Optional explicit rollback path.
# Set LLM_PROVIDER="gemini" to use GEMINI_API_KEY again.

# For the first production rollout, point both sidecar pairs to the same Cloud Run adapter.
BILLING_TEST_MODE="false"

# Crystal core remote runtime.
CRYSTAL_CORE_BASE_URL=""
CRYSTAL_CORE_INVOKER_AUDIENCE=""
CRYSTAL_CORE_REGION="europe-west1"
CRYSTAL_CORE_EVAL_JOB_NAME="crystal-core-eval"
CRYSTAL_CORE_ROLLOUT_PERCENT="0"
CRYSTAL_CORE_GUEST_ROLLOUT_PERCENT="0"
CRYSTAL_CORE_ROLLOUT_SALT=""
CRYSTAL_LEGACY_EMERGENCY_FALLBACK="true"
