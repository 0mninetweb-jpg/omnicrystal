{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile in the Crystal application.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "location": { "type": "string", "description": "User location used for personalization." },
        "profession": { "type": "string", "description": "User role or industry." },
        "interests": { "type": "array", "items": { "type": "string" } },
        "plan": { "type": "string", "enum": ["free", "plus", "pro"] },
        "planStatus": { "type": "string", "enum": ["active", "past_due", "canceled"] },
        "creditsBalance": { "type": "number" },
        "creditsCycleAmount": { "type": "number" },
        "creditsResetAt": { "type": "string", "format": "date-time" },
        "watchlistLimit": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "CrystalCard": {
      "title": "CrystalCard",
      "description": "A saved forecast card generated by Crystal.",
      "type": "object",
      "properties": {
        "card_id": { "type": "string" },
        "card_type": { "type": "string" },
        "domain": { "type": "string" },
        "stakes_level": { "type": "string" },
        "risk_band": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "verdict": { "type": "string" },
        "scenario_set": { "type": "array" },
        "so_what": { "type": "array" },
        "ranked_list": { "type": "array" },
        "drivers": { "type": "array" },
        "trust_layer": { "type": "object" },
        "prediction_market_frame": { "type": "object" },
        "world_sim": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["card_id", "title", "createdAt"]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "An entity monitored by the user.",
      "type": "object",
      "properties": {
        "entity": { "type": "string" },
        "type": { "type": "string" },
        "domains": { "type": "array", "items": { "type": "string" } },
        "alerts": { "type": "boolean" },
        "pulse": { "type": "string" },
        "trend": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["entity", "type", "createdAt"]
    },
    "SavedQuote": {
      "title": "SavedQuote",
      "description": "A saved Crystal Quote with its analysis payload.",
      "type": "object",
      "properties": {
        "quote_id": { "type": "string" },
        "text": { "type": "string" },
        "author": { "type": "string" },
        "context": { "type": "string" },
        "date": { "type": "string" },
        "analysis": { "type": "object" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["quote_id", "text", "author", "context", "analysis", "date", "savedAt"]
    },
    "WorldSimJob": {
      "title": "WorldSimJob",
      "description": "A mirrored runtime job for WorldSim or Matrix Simulation.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "jobId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["created", "queued", "preparing", "ready", "running", "completed", "failed", "canceled"]
        },
        "source": { "type": "string" },
        "sourceRef": { "type": "string" },
        "jobType": { "type": "string" },
        "progress": { "type": "number" },
        "agentCount": { "type": "number" },
        "depth": { "type": "string" },
        "statusMessage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "jobId", "status"]
    },
    "CreditEvent": {
      "title": "CreditEvent",
      "description": "A server-managed credit ledger entry.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "delta": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "source": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "userOwnedData": {
      "/users/{userId}": {
        "schema": { "$ref": "#/entities/User" },
        "description": "User profile and entitlements state."
      },
      "/users/{userId}/cards/{cardId}": {
        "schema": { "$ref": "#/entities/CrystalCard" },
        "description": "Saved forecast cards for a specific user."
      },
      "/users/{userId}/watchlist/{itemId}": {
        "schema": { "$ref": "#/entities/WatchlistItem" },
        "description": "Watchlist entries saved by the user."
      },
      "/users/{userId}/saved_quotes/{quoteId}": {
        "schema": { "$ref": "#/entities/SavedQuote" },
        "description": "Saved Crystal Quotes with analysis metadata."
      },
      "/users/{userId}/credit_events/{eventId}": {
        "schema": { "$ref": "#/entities/CreditEvent" },
        "description": "Server-managed credit history visible to the owner."
      }
    },
    "runtimeAndJobs": {
      "/worldsim_jobs/{jobId}": {
        "schema": { "$ref": "#/entities/WorldSimJob" },
        "description": "Runtime job mirror used for WorldSim and Matrix Simulation polling."
      }
    },
    "systemManagedCollections": {
      "/world_sim_cache/{document=**}": {
        "description": "Server-managed cache for normalized WorldSim digests.",
        "access": "No direct client access."
      },
      "/polymarket_search_cache/{document=**}": {
        "description": "Server-managed cache for Polymarket candidate market discovery.",
        "access": "No direct client access."
      },
      "/polymarket_signal_cache/{document=**}": {
        "description": "Server-managed cache for Polymarket pricing and liquidity signals.",
        "access": "No direct client access."
      },
      "/cached_cards/{domain}/{city}/{cardId}": {
        "description": "Shared cached cards hydrated by the backend and readable to authenticated users.",
        "access": "Read-only for authenticated clients."
      },
      "/system_cache/{document=**}": {
        "description": "Reserved internal cache space.",
        "access": "No direct client access."
      },
      "/facts/{document=**}": {
        "description": "Reserved internal facts store.",
        "access": "No direct client access."
      },
      "/trust_layer/{document=**}": {
        "description": "Reserved internal trust-layer materialization.",
        "access": "No direct client access."
      },
      "/historical_20y_summaries/{document=**}": {
        "description": "Reserved internal historical summaries cache.",
        "access": "No direct client access."
      },
      "/pipeline_logs/{document=**}": {
        "description": "Reserved internal pipeline logs.",
        "access": "No direct client access."
      }
    }
  }
}
