{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the Crystal application.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "location": { "type": "string", "description": "User's geographical location" },
        "profession": { "type": "string", "description": "User's job or industry" },
        "interests": { "type": "array", "items": { "type": "string" }, "description": "Topics the user is interested in" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "CrystalCard": {
      "title": "CrystalCard",
      "description": "A saved predictive card generated by Crystal.",
      "type": "object",
      "properties": {
        "card_id": { "type": "string" },
        "card_type": { "type": "string" },
        "domain": { "type": "string" },
        "stakes_level": { "type": "string" },
        "risk_band": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "verdict": { "type": "string" },
        "scenario_set": { "type": "array" },
        "so_what": { "type": "array" },
        "ranked_list": { "type": "array" },
        "drivers": { "type": "array" },
        "trust_layer": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["card_id", "title", "createdAt"]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "An entity monitored by the user.",
      "type": "object",
      "properties": {
        "entity": { "type": "string" },
        "type": { "type": "string" },
        "domains": { "type": "array", "items": { "type": "string" } },
        "alerts": { "type": "boolean" },
        "pulse": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["entity", "type", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles."
    },
    "/users/{userId}/cards/{cardId}": {
      "schema": { "$ref": "#/entities/CrystalCard" },
      "description": "Saved predictive cards for a specific user."
    },
    "/users/{userId}/watchlist/{itemId}": {
      "schema": { "$ref": "#/entities/WatchlistItem" },
      "description": "Watchlist items for a specific user."
    }
  }
}
