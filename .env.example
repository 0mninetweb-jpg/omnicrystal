# GEMINI_API_KEY: Server-side secret for Firebase Functions.
# Set with: firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NIXTLA_API_KEY: Optional server-side secret for TimeGPT inside Firebase Functions.
# Set with: firebase functions:secrets:set NIXTLA_API_KEY
NIXTLA_API_KEY="MY_NIXTLA_API_KEY"

# WORLDSIM_BASE_URL: Optional URL of the MiroFish-style sidecar used by Crystal Oracle.
# Example: http://localhost:8081 or https://world-sim-your-service.run.app
WORLDSIM_BASE_URL=""

# WORLDSIM_API_KEY: Shared key used by Firebase Functions to call the WorldSim sidecar.
WORLDSIM_API_KEY=""

# STRIPE_SECRET_KEY: Server-side secret for Stripe Checkout.
# Set with: firebase functions:secrets:set STRIPE_SECRET_KEY
STRIPE_SECRET_KEY="sk_test_..."

# STRIPE_WEBHOOK_SECRET: Server-side secret to verify Stripe webhook events.
# Set with: firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
STRIPE_WEBHOOK_SECRET="whsec_..."

# VITE_API_BASE_URL: Optional public base URL for the deployed backend.
# Example: https://europe-west1-your-project.cloudfunctions.net/api
VITE_API_BASE_URL="/api"

# VITE_ALLOW_CLIENT_AI_FALLBACK: Enable only for local development if the backend is offline.
VITE_ALLOW_CLIENT_AI_FALLBACK="false"

# VITE_GEMINI_API_KEY: Temporary client-side fallback while the backend is not deployed.
# Remove it once Firebase Functions are live.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"
