# Copy into functions/.env.omnicrystal after the adapter is deployed.

MIROFISH_BASE_URL=https://your-cloud-run-adapter-url
MIROFISH_API_KEY=replace-with-the-worldsim-api-key

WORLDSIM_BASE_URL=https://your-cloud-run-adapter-url
WORLDSIM_API_KEY=replace-with-the-worldsim-api-key

LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-with-the-openrouter-api-key
LLM_MODEL_QUERY=openai/gpt-4.1-mini
LLM_MODEL_FORECAST=openai/gpt-4.1
LLM_MODEL_CHAT=openai/gpt-4.1-mini
LLM_MODEL_COPY=openai/gpt-4.1-mini
